%{
#include "exp10.tab.h"
%}

%%
"for"       { return FOR; }
"int"       { return INT; }
[A-Za-z_][A-Za-z0-9_]* { return ID; }
[0-9]+      { return NUM; }
"++"|"--"   { return INCDEC; }
"<="|">="|"=="|"!="|"<"|">" { return RELOP; }
"="         { return '='; }
"+"|"-"|"*"|"/" { return yytext[0]; }
[();{}]     { return yytext[0]; }
[ \t\n]+    ;
.           { return yytext[0]; }
%%

int yywrap() { return 1; }

-----------------------------------------------------

%{
#include <stdio.h>
int yylex(void);
void yyerror(const char *s);
%}

%token FOR INT ID NUM INCDEC RELOP

%%
program: FOR '(' init ';' condition ';' update ')' block {
            printf("Valid FOR loop\n");
         }
       ;

init: INT ID '=' NUM
    | ID '=' NUM
    ;

condition: ID RELOP NUM
         | ID RELOP ID
         ;

update: ID INCDEC
      | INCDEC ID
      | ID '=' ID '+' NUM
      | ID '=' ID '-' NUM
      ;

block: '{' '}'
     | '{' statements '}'
     | statement
     ;

statements: statement
          | statements statement
          ;

statement: ID '=' expression ';'
         | ID INCDEC ';'
         | ';'
         ;

expression: ID
          | NUM
          | expression '+' expression
          | expression '-' expression
          | expression '*' expression
          | expression '/' expression
          | '(' expression ')'
          ;
%%

void yyerror(const char *s) {
    printf("Invalid FOR loop: %s\n", s);
}

int main() {
    printf("Enter FOR loop, e.g. for(i=0; i<5; i++) {}\n");
    return yyparse();
}
