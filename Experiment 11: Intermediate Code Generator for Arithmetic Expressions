%{
#include "exp11.tab.h"
#include <stdlib.h>
#include <string.h>
%}

%%
[0-9]+ {
    yylval.num = atoi(yytext);
    return NUMBER;
}
[A-Za-z_][A-Za-z0-9_]* {
    yylval.str = strdup(yytext);
    return ID;
}
[ \t\n]+    ;
.           { return yytext[0]; }
%%

int yywrap() { return 1; }

-----------------------------------------------------------

%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int yylex(void);
void yyerror(const char *s);
int temp = 1;

char *newtemp() {
    char *s = malloc(20);
    sprintf(s, "t%d", temp++);
    return s;
}
%}

%union {
    int num;
    char *str;
}

%token <num> NUMBER
%token <str> ID
%type <str> expr

%left '+' '-'
%left '*' '/'

%%
input: expr {
          printf("Final result stored in %s\n", $1);
      }
     ;

expr: NUMBER {
         $$ = newtemp();
         printf("%s = %d\n", $$, $1);
     }
    | ID { $$ = $1; }
    | expr '+' expr {
         $$ = newtemp();
         printf("%s = %s + %s\n", $$, $1, $3);
     }
    | expr '-' expr {
         $$ = newtemp();
         printf("%s = %s - %s\n", $$, $1, $3);
     }
    | expr '*' expr {
         $$ = newtemp();
         printf("%s = %s * %s\n", $$, $1, $3);
     }
    | expr '/' expr {
         $$ = newtemp();
         printf("%s = %s / %s\n", $$, $1, $3);
     }
    | '(' expr ')' { $$ = $2; }
    ;
%%

void yyerror(const char *s) {
    printf("Error: %s\n", s);
}

int main() {
    printf("Enter arithmetic expression:\n");
    return yyparse();
}
