%{
#include <stdio.h>
int count = 0;
%}

%%
[Aa][a-zA-Z0-9_]*  { printf("%s\n", yytext); count++; }
[a-zA-Z0-9_]+      ;
[ \t\n]+           ;
.                  ;
%%

int yywrap() { return 1; }

int main() {
    printf("Enter text:\n");
    yylex();
    printf("Words starting with A: %d\n", count);
    return 0;
}
