%{
#include "exp4.tab.h"
#include <stdlib.h>
%}

%%
[0-9]+      { yylval = atoi(yytext); return NUMBER; }
[ \t\n]+    ;
.           { return yytext[0]; }
%%

int yywrap() { return 1; }

-------------------------------------------------------
%{
#include <stdio.h>
int yylex(void);
void yyerror(const char *s);
%}

%token NUMBER
%left '+' '-'
%left '*' '/'

%%
input: expr { printf("Result = %d\n", $1); }
     ;

expr: NUMBER
    | expr '+' expr { $$ = $1 + $3; }
    | expr '-' expr { $$ = $1 - $3; }
    | expr '*' expr { $$ = $1 * $3; }
    | expr '/' expr {
          if ($3 == 0) {
              yyerror("Division by zero");
              $$ = 0;
          } else $$ = $1 / $3;
      }
    | '(' expr ')' { $$ = $2; }
    ;
%%

void yyerror(const char *s) {
    printf("Error: %s\n", s);
}

int main() {
    printf("Enter arithmetic expression:\n");
    return yyparse();
}
